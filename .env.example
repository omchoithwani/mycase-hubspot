# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3001

# ─── Database (Neon.tech / any Postgres) ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mycase_hubspot

# ─── Encryption ─────────────────────────────────────────────────────────────────
# 32-byte hex string: openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# ─── HubSpot App ────────────────────────────────────────────────────────────────
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_APP_ID=your_hubspot_app_id
# Scopes (space-separated)
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write crm.objects.deals.read crm.objects.deals.write crm.schemas.contacts.write oauth

# ─── MyCase App ─────────────────────────────────────────────────────────────────
MYCASE_CLIENT_ID=your_mycase_client_id
MYCASE_CLIENT_SECRET=your_mycase_client_secret
MYCASE_REDIRECT_URI=http://localhost:3001/auth/mycase/callback

# ─── Admin UI ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
