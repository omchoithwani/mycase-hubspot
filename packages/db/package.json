{
  "name": "@mycase-hubspot/db",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migrate:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migrate:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts"
  },
  "dependencies": {
    "typeorm": "^0.3.20",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "@types/node": "^22.13.14"
  }
}
